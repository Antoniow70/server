# ==============================================================
# CONFIGURAÇÃO DE AMBIENTE - BACKEND (ALEM)
# Em produção (Render / Railway), configure estas variáveis no painel da plataforma.
# ==============================================================

# Porta da aplicação (No Render/Railway, esta variável é injetada automaticamente)
PORT=3001
NODE_ENV=production

# Supabase Credentials (Project Settings > API no Supabase Dashboard)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Chave secreta de serviço (usada pelo backend para operações administrativas e uploads)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL(s) permitida(s) no CORS e para redirecionamento de recuperação de senha
# Pode incluir múltiplas URLs separadas por vírgula (ex: https://alem-eight.vercel.app,https://meusite.org)
FRONTEND_URL=https://alem-eight.vercel.app

# Configuração de envio de email (Nodemailer SMTP / Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
